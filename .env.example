# --- Elastic Cloud Serverless (Console -> your project -> Connection details) ---
ELASTICSEARCH_URL=https://YOUR-PROJECT.es.REGION.aws.elastic.cloud
ELASTIC_API_KEY=
# Kibana URL (only needed for Agent Builder tools/agent registration + MCP)
KIBANA_URL=https://YOUR-PROJECT.kb.REGION.aws.elastic.cloud

# --- Mistral ---
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-4
MISTRAL_EXTRACT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# --- Optional ---
SOCRATA_APP_TOKEN=
WINDOW_MONTHS=12
VIOLATION_LOOKBACK_MONTHS=24
SEMANTIC_MAX_DOCS=20000
# AS_OF=2026-10-07   # pin "today" for reproducible checks
